# Flight data. At least one is required — the app refuses to start without a
# provider rather than inventing flight outcomes.
# AeroDataBox via RapidAPI: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_KEY=
# AviationStack: https://aviationstack.com
AVIATIONSTACK_KEY=

# Monad testnet. Do NOT use testnet-rpc.monad.xyz: it throttles at 15 req/sec
# and returns the refusal as a JSON-RPC error inside an HTTP 200, which retry
# logic does not catch.
MONAD_RPC_URL=https://rpc.ankr.com/monad_testnet
MONAD_CHAIN_ID=10143

# Pays gas to attest flights and settle policies.
DEPLOYER_PRIVATE_KEY=
# Signs flight attestations. Never needs funding — it only signs.
ATTESTOR_A_PRIVATE_KEY=
ATTESTOR_B_PRIVATE_KEY=

# Pricing
TARGET_MARGIN_BPS=1500
DEFAULT_RECOVERY_PROB=0.65
COLLECTION_COST_EUR=25
